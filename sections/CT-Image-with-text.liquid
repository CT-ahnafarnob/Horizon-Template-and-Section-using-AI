{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.text_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .ct-image-with-text {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --heading-font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    --heading-font-weight: {{ section.settings.heading_font.weight }};
    --heading-font-style: {{ section.settings.heading_font.style }};
    --text-font-family: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
    --text-font-weight: {{ section.settings.text_font.weight }};
    --text-font-style: {{ section.settings.text_font.style }};
    --heading-size: {{ section.settings.heading_size }}px;
    --text-size: {{ section.settings.text_size }}px;

    background-color: var(--bg-color);
    color: var(--text-color);
  }
{%- endstyle -%}

{%- stylesheet -%}
  .ct-image-with-text {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 2rem;
    padding: 2rem;
    width: 100%;
    box-sizing: border-box;
  }

  .ct-image-with-text--reverse {
    flex-direction: row-reverse;
  }

  .ct-image-with-text__image-wrapper {
    flex: 1 1 0;
    min-width: 0;
  }

  .ct-image-with-text__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ct-image-with-text__content-wrapper {
    flex: 1 1 0;
    min-width: 0;
  }

  .ct-image-with-text__heading {
    font-family: var(--heading-font-family);
    font-weight: var(--heading-font-weight);
    font-style: var(--heading-font-style);
    font-size: var(--heading-size);
    margin: 0 0 1rem 0;
    color: inherit;
    line-height: 1.2;
  }

  .ct-image-with-text__text {
    font-family: var(--text-font-family);
    font-weight: var(--text-font-weight);
    font-style: var(--text-font-style);
    font-size: var(--text-size);
    color: inherit;
    line-height: 1.5;
  }
  
  .ct-image-with-text__text p {
    margin: 0;
  }
  
  @media screen and (max-width: 768px) {
    .ct-image-with-text,
    .ct-image-with-text--reverse {
      flex-direction: column;
    }
    .ct-image-with-text__image-wrapper,
    .ct-image-with-text__content-wrapper {
      width: 100%;
    }
  }
{%- endstylesheet -%}

<div class="ct-image-with-text {% if section.settings.layout == 'text_first' %}ct-image-with-text--reverse{% endif %}">
  <div class="ct-image-with-text__image-wrapper">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy', class: 'ct-image-with-text__image', widths: '375, 550, 750, 1100, 1500' }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'ct-image-with-text__image placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="ct-image-with-text__content-wrapper">
    {%- if section.settings.heading != blank -%}
      <h2 class="ct-image-with-text__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="ct-image-with-text__text">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "CT Image with Text",
  "enabled_on": {
    "templates": ["index", "page", "product", "collection", "blog", "article"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Position",
      "options": [
        {
          "value": "image_first",
          "label": "Left"
        },
        {
          "value": "text_first",
          "label": "Right"
        }
      ],
      "default": "image_first"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image with text"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading Font",
      "default": "work_sans_n6"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 12,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Text Font",
      "default": "work_sans_n4"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 10,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "CT Image with Text",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}